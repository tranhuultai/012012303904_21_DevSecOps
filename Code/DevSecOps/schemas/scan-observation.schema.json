{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Traceable CI scan observation",
  "type": "object",
  "required": [
    "schema_version", "evidence_status", "sample_type", "fixture_id", "run_id",
    "run_attempt", "run_url", "commit", "ref", "event", "recorded_at",
    "cache_mode", "benchmark_role", "scan_execution_mode", "scan_stage_started_at", "scan_stage_ended_at",
    "e4_evidence_status", "e4_requested", "e4_raw_reports",
    "policy_configured", "trivy_db_snapshot_id", "tool_versions_configured", "raw_reports", "trivy_runtime", "grype_runtime",
    "normalized_findings", "gate", "policy_runs", "skipped_scans", "timing", "issues", "interpretation"
  ],
  "properties": {
    "schema_version": {"const": 6},
    "evidence_status": {"enum": ["complete", "partial"]},
    "sample_type": {"enum": ["repository-baseline", "patch-fixture"]},
    "fixture_id": {"type": "string", "pattern": "^(baseline|[DCN][0-9]{2})$"},
    "cache_mode": {"enum": ["cold", "warm"]},
    "benchmark_role": {"enum": ["measurement", "warmup"]},
    "scan_execution_mode": {"const": "parallel"},
    "scan_stage_started_at": {"type": "string", "format": "date-time"},
    "scan_stage_ended_at": {"type": "string", "format": "date-time"},
    "e4_evidence_status": {"enum": ["not_requested", "complete", "incomplete"]},
    "e4_requested": {"type": "boolean"},
    "e4_raw_reports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["present"],
        "properties": {
          "present": {"type": "boolean"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "run_id": {"type": "string"},
    "run_attempt": {"type": "string"},
    "run_url": {"type": "string", "format": "uri-reference"},
    "commit": {"type": "string"},
    "ref": {"type": "string"},
    "event": {"type": "string"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "policy_configured": {"type": "string"},
    "trivy_db_snapshot_id": {"type": "string", "minLength": 1},
    "tool_versions_configured": {
      "type": "object",
      "required": ["semgrep", "gitleaks", "trivy", "checkov", "syft", "grype", "conftest"],
      "additionalProperties": {"type": "string"}
    },
    "raw_reports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["present"],
        "properties": {
          "present": {"type": "boolean"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "error": {"type": "string"}
        }
      }
    },
    "trivy_runtime": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["trivy_version", "databases", "error"],
        "properties": {
          "trivy_version": {"type": ["string", "null"]},
          "databases": {"type": "object"},
          "error": {"type": ["string", "null"]}
        }
      }
    },
    "grype_runtime": {
      "type": "object",
      "required": ["grype_version", "db_snapshot_id", "image_scan_skipped", "db", "error"],
      "properties": {
        "grype_version": {"type": ["string", "null"]},
        "db_snapshot_id": {"type": "string", "minLength": 1},
        "image_scan_skipped": {"type": "boolean"},
        "db": {
          "type": ["object", "null"],
          "properties": {
            "schema_version": {"type": ["string", "null"]},
            "built": {"type": ["string", "null"]},
            "from": {"type": ["string", "null"]},
            "valid": {"type": ["boolean", "null"]}
          }
        },
        "error": {"type": ["string", "null"]}
      }
    },
    "normalized_findings": {
      "type": "object",
      "required": ["count", "by_tool", "by_severity", "items"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "by_tool": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "by_severity": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "rule_id", "category", "severity", "file", "resource", "fingerprint"],
            "properties": {
              "tool": {"type": ["string", "null"]},
              "rule_id": {"type": ["string", "null"]},
              "category": {"type": ["string", "null"]},
              "severity": {"type": ["string", "null"]},
              "file": {"type": ["string", "null"]},
              "resource": {"type": ["string", "null"]},
              "fingerprint": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "gate": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["policy", "decision", "summary"],
          "properties": {
            "policy": {"type": ["string", "null"]},
            "decision": {"enum": ["PASS", "WARN", "BLOCK"]},
            "summary": {"type": "object"}
          }
        }
      ]
    },
    "policy_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["policy", "decision", "summary", "blockers", "warnings"],
        "properties": {
          "policy": {"enum": ["g0", "g1", "g2"]},
          "decision": {"enum": ["PASS", "WARN", "BLOCK"]},
          "summary": {"type": "object"},
          "blockers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rule_id", "message", "file"],
              "properties": {
                "rule_id": {"type": ["string", "null"]},
                "message": {"type": ["string", "null"]},
                "file": {"type": ["string", "null"]}
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rule_id", "message", "file", "severity", "advisory_ids", "control_ids", "affected_findings"],
              "properties": {
                "rule_id": {"type": ["string", "null"]},
                "message": {"type": ["string", "null"]},
                "file": {"type": ["string", "null"]},
                "severity": {"type": ["string", "null"]},
                "advisory_ids": {"type": "array", "items": {"type": "string"}},
                "control_ids": {"type": "array", "items": {"type": "string"}},
                "affected_findings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["tool", "category", "title", "file", "resource", "package", "installed_version"],
                    "properties": {
                      "tool": {"type": ["string", "null"]},
                      "category": {"type": ["string", "null"]},
                      "title": {"type": ["string", "null"]},
                      "file": {"type": ["string", "null"]},
                      "resource": {"type": ["string", "null"]},
                      "package": {"type": ["string", "null"]},
                      "installed_version": {"type": ["string", "null"]}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "skipped_scans": {"type": "array", "items": {"type": "string"}},
    "timing": {"type": ["object", "null"]},
    "issues": {"type": "array", "items": {"type": "string"}},
    "interpretation": {"type": "string"}
  },
  "additionalProperties": false
}
