{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gate_input",
  "type": "object",
  "required": ["findings", "exceptions", "context"],
  "properties": {
    "context": {
      "type": "object",
      "required": ["today", "policy"],
      "properties": {
        "today": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "policy": {"enum": ["g0", "g1", "g2"]}
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "match", "severity", "reason", "owner", "approved_by", "created", "expires"],
        "properties": {
          "id": {"type": "string"},
          "match": {
            "type": "object",
            "required": ["rule_id", "resource"],
            "properties": {
              "rule_id": {"type": "string"},
              "resource": {"type": "string"}
            }
          },
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
          "reason": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "approved_by": {"type": "string", "minLength": 1},
          "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "expires": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "rule_id", "severity"],
        "properties": {
          "category": {"enum": ["secret", "sca", "image", "iac", "container", "k8s", "sast", "ci"]},
          "rule_id": {"type": "string"},
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
          "kev": {"type": "boolean"},
          "fix_available": {"type": "boolean"},
          "match_confidence": {"enum": ["high", "low"]},
          "location": {"type": "object"}
        }
      }
    }
  }
}
