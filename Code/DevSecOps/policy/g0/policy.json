{
  "policy_version": "1.0",
  "profile": "g0",
  "description": "Baseline policy: collect and report findings without blocking releases based on severity.",
  "blocking_severities": [],
  "warning_severities": [
    "CRITICAL",
    "HIGH",
    "MEDIUM"
  ],
  "informational_severities": [
    "LOW",
    "INFO"
  ],
  "fail_on_invalid_policy": true,
  "exception_policy": {
    "enabled": true,
    "require_reason": true,
    "require_expiry": true,
    "max_validity_days": 30,
    "expired_exception_action": "block"
  }
}
