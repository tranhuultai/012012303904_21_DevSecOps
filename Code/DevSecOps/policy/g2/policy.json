{
  "policy_version": "1.0",
  "profile": "g2",
  "description": "Strict release policy: block critical, high and medium findings.",
  "blocking_severities": [
    "CRITICAL",
    "HIGH",
    "MEDIUM"
  ],
  "warning_severities": [],
  "informational_severities": [
    "LOW",
    "INFO"
  ],
  "fail_on_invalid_policy": true,
  "exception_policy": {
    "enabled": true,
    "require_reason": true,
    "require_expiry": true,
    "max_validity_days": 7,
    "expired_exception_action": "block"
  }
}